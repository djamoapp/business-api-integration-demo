meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: none
}

body:json {
  {
    "userId": "{{userId}}",
    "items": [
      {
        "id": 1,
        "name": "Café Djamo",
        "price": 2500,
        "quantity": 2
      }
    ],
    "customerInfo": {
      "name": "Jean Dupont",
      "email": "jean@example.com",
      "phone": "+2250700000000"
    }
  }
}
